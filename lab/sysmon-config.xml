<?xml version="1.0" encoding="utf-8"?>
<!--
Sysmon Configuration for SIEM Detection Lab
Based on SwiftOnSecurity template with customizations for detection engineering
https://github.com/SwiftOnSecurity/sysmon-config

This configuration captures events critical for detection rules:
- Process creation (Event ID 1)
- Network connections (Event ID 3)
- Process access (Event ID 10)
- File creation (Event ID 11)
- Registry modifications (Event ID 13)
- DNS queries (Event ID 22)
-->

<Sysmon schemaversion="4.90">
  <EventFiltering>

    <!-- Event ID 1: Process Creation -->
    <RuleGroup name="" groupRelation="or">
      <ProcessCreate onmatch="exclude">
        <!-- Exclude very noisy but benign processes -->
        <Image condition="is">C:\Windows\System32\svchost.exe</Image>
        <Image condition="is">C:\Windows\System32\conhost.exe</Image>
        <Image condition="is">C:\Windows\System32\backgroundTaskHost.exe</Image>

        <!-- Include all other process creation -->
      </ProcessCreate>
    </RuleGroup>

    <!-- Event ID 3: Network Connection -->
    <RuleGroup name="" groupRelation="or">
      <NetworkConnect onmatch="exclude">
        <!-- Exclude internal connections -->
        <DestinationIp condition="is">127.0.0.1</DestinationIp>
        <DestinationIp condition="is">::1</DestinationIp>

        <!-- Exclude multicast/broadcast -->
        <DestinationIp condition="begin with">224.0.0</DestinationIp>
        <DestinationIp condition="begin with">ff02::</DestinationIp>
      </NetworkConnect>
    </RuleGroup>

    <!-- Event ID 5: Process Terminated (minimal logging) -->
    <RuleGroup name="" groupRelation="or">
      <ProcessTerminate onmatch="include">
        <!-- Only log termination of suspicious processes -->
        <Image condition="contains">mimikatz</Image>
        <Image condition="contains">nc.exe</Image>
        <Image condition="contains">psexec</Image>
      </ProcessTerminate>
    </RuleGroup>

    <!-- Event ID 7: Image Loaded (DLL) -->
    <RuleGroup name="" groupRelation="or">
      <ImageLoad onmatch="include">
        <!-- Focus on suspicious DLL loads -->
        <ImageLoaded condition="contains">\AppData\Local\Temp\</ImageLoaded>
        <ImageLoaded condition="contains">\Users\Public\</ImageLoaded>
        <Signed condition="is">false</Signed>
      </ImageLoad>
    </RuleGroup>

    <!-- Event ID 8: CreateRemoteThread (Process Injection) -->
    <RuleGroup name="" groupRelation="or">
      <CreateRemoteThread onmatch="include">
        <!-- Log all CreateRemoteThread events (key for injection detection) -->
      </CreateRemoteThread>
    </RuleGroup>

    <!-- Event ID 10: ProcessAccess (LSASS, credential dumping) -->
    <RuleGroup name="" groupRelation="or">
      <ProcessAccess onmatch="include">
        <!-- Log access to sensitive processes -->
        <TargetImage condition="end with">lsass.exe</TargetImage>
        <TargetImage condition="end with">csrss.exe</TargetImage>
        <TargetImage condition="end with">winlogon.exe</TargetImage>
      </ProcessAccess>
    </RuleGroup>

    <!-- Event ID 11: File Creation -->
    <RuleGroup name="" groupRelation="or">
      <FileCreate onmatch="include">
        <!-- Focus on suspicious file creation locations -->
        <TargetFilename condition="contains">\Startup\</TargetFilename>
        <TargetFilename condition="contains">\AppData\Roaming\Microsoft\Windows\Start Menu\Programs\Startup\</TargetFilename>
        <TargetFilename condition="contains">\Users\Public\</TargetFilename>
        <TargetFilename condition="contains">\Windows\Temp\</TargetFilename>
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
        <TargetFilename condition="end with">.bat</TargetFilename>
        <TargetFilename condition="end with">.cmd</TargetFilename>
        <TargetFilename condition="end with">.ps1</TargetFilename>
        <TargetFilename condition="end with">.vbs</TargetFilename>
      </FileCreate>
    </RuleGroup>

    <!-- Event ID 12/13/14: Registry Operations -->
    <RuleGroup name="" groupRelation="or">
      <RegistryEvent onmatch="include">
        <!-- Focus on persistence and autostart locations -->
        <TargetObject condition="contains">\CurrentVersion\Run</TargetObject>
        <TargetObject condition="contains">\CurrentVersion\RunOnce</TargetObject>
        <TargetObject condition="contains">\CurrentVersion\Windows\Load</TargetObject>
        <TargetObject condition="contains">\CurrentVersion\Winlogon\</TargetObject>
        <TargetObject condition="contains">\Microsoft\Windows\CurrentVersion\Policies\Explorer\Run</TargetObject>
        <TargetObject condition="contains">\Microsoft\Windows NT\CurrentVersion\Winlogon\Userinit</TargetObject>
        <TargetObject condition="contains">\Microsoft\Windows NT\CurrentVersion\Winlogon\Shell</TargetObject>
      </RegistryEvent>
    </RuleGroup>

    <!-- Event ID 15: FileCreateStreamHash (ADS) -->
    <RuleGroup name="" groupRelation="or">
      <FileCreateStreamHash onmatch="include">
        <!-- Log Alternate Data Streams (potential hiding) -->
        <TargetFilename condition="contains">:</TargetFilename>
      </FileCreateStreamHash>
    </RuleGroup>

    <!-- Event ID 17/18: Pipe Events -->
    <RuleGroup name="" groupRelation="or">
      <PipeEvent onmatch="include">
        <!-- Focus on named pipes used by remote execution tools -->
        <PipeName condition="contains">psexec</PipeName>
        <PipeName condition="contains">paexec</PipeName>
        <PipeName condition="contains">remcom</PipeName>
        <PipeName condition="contains">csexec</PipeName>
      </PipeEvent>
    </RuleGroup>

    <!-- Event ID 19/20/21: WMI Events -->
    <RuleGroup name="" groupRelation="or">
      <WmiEvent onmatch="include">
        <!-- Log all WMI event consumer activity (persistence) -->
      </WmiEvent>
    </RuleGroup>

    <!-- Event ID 22: DNS Query -->
    <RuleGroup name="" groupRelation="or">
      <DnsQuery onmatch="exclude">
        <!-- Exclude internal DNS -->
        <QueryName condition="end with">.local</QueryName>
        <QueryName condition="end with">.internal</QueryName>

        <!-- Exclude common legitimate queries to reduce noise -->
        <QueryName condition="end with">microsoft.com</QueryName>
        <QueryName condition="end with">windows.com</QueryName>
        <QueryName condition="end with">windowsupdate.com</QueryName>
      </DnsQuery>
    </RuleGroup>

    <!-- Event ID 23: File Delete -->
    <RuleGroup name="" groupRelation="or">
      <FileDelete onmatch="include">
        <!-- Log deletions in sensitive locations -->
        <TargetFilename condition="contains">\Windows\System32\</TargetFilename>
        <TargetFilename condition="contains">\Windows\SysWOW64\</TargetFilename>
      </FileDelete>
    </RuleGroup>

    <!-- Event ID 25: Process Tampering -->
    <RuleGroup name="" groupRelation="or">
      <ProcessTampering onmatch="include">
        <!-- Log all process tampering events (hollowing, etc.) -->
      </ProcessTampering>
    </RuleGroup>

    <!-- Event ID 26: File Delete Logged -->
    <RuleGroup name="" groupRelation="or">
      <FileDeleteDetected onmatch="include">
        <!-- Log file deletion attempts -->
        <TargetFilename condition="end with">.exe</TargetFilename>
        <TargetFilename condition="end with">.dll</TargetFilename>
      </FileDeleteDetected>
    </RuleGroup>

  </EventFiltering>
</Sysmon>
